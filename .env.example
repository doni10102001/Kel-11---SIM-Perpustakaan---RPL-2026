APP_NAME="SIM Perpustakaan"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Phase 7A: MySQL 8.4 lokal, user least-privilege (bukan root). Zona sesi DB = UTC (config/database.php).
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=sim_perpustakaan_db
DB_USERNAME=sim_perpus_app
DB_PASSWORD=
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_0900_ai_ci
# Database khusus pengujian otomatis (MySQL). Wajib berakhiran _test.
DB_TEST_DATABASE=sim_perpustakaan_test
DB_TEST_USERNAME=sim_perpus_test
DB_TEST_PASSWORD=

# Provisioning kata sandi awal Admin untuk seeder development (isi lokal di .env, jangan di-commit).
# Hanya dipakai saat akun Admin belum ada; boleh dihapus setelah seeding pertama.
# Akun Anggota hasil seed selalu diberi hash acak (reset oleh Admin pada fase berikutnya).
SEED_ADMIN_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

CACHE_STORE=file
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Inertia DevTools (perekam request ke disk untuk ekstensi Chrome). Nonaktif secara default.
INERTIA_DEVTOOLS_ENABLED=false
