            end
            S->>O: BookCopy → Dipesan
            O->>DB: UPDATE book_copies
            S->>DB: INSERT audit_logs booking.disetujui (batas_pengambilan UTC)
            S->>DB: COMMIT
        end
    end
    C-->>V: 302 + flash berisi Batas Pengambilan (WIB)
